# Copy this file to .env and export the variables in your shell.
# Do not commit .env. The clients read these names and never write the key to disk.

OPENAI_API_KEY=
XAI_API_KEY=

# SSH name of the machine that renders audiobooks. The scripts have no default.
# NARRATION_HOST=
# NARRATION_DEST=bedtime-audiobooks
# Python on the render machine. The default is ~/miniforge3/envs/bedtime/bin/python.
# NARRATION_PYTHON=

# Local model for long_story.py.
# STORY_ENDPOINT=http://127.0.0.1:18888/v1
# STORY_MODEL=deepseek-v4.1-flash

# Optional. A systemd --user unit that holds the GPU. Leave unset to stop nothing.
# GPU_HOLD_SERVICE=

# Optional. A photo used only as an art reference. Keep it outside the repo.
# HERO_PHOTO=
